# Use environment variables locally; this file is not automatically sourced.
OPENALEX_API_KEY=
BRAVE_API_KEY=
# Or use SERPER_API_KEY for Google search through Serper.
SERPER_API_KEY=
LLM_API_KEY=
# HTTPS base URL of a provider with an OpenAI-compatible /chat/completions endpoint.
LLM_BASE_URL=
LLM_MODEL=
# Optional official NotebookLM Enterprise integration.
NOTEBOOKLM_NOTEBOOK=
NOTEBOOKLM_REGION=global
GOOGLE_ACCESS_TOKEN=
# For daily access-token refresh with a user-authorized OAuth grant:
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
